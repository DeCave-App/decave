{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "decave-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,

  "routes": [
    {
      "pattern": "de-cave.com",
      "custom_domain": true
    }
  ],

  "vars": {
    "PUBLIC_RELEASE_MODE": "disabled"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/downloads/*"
    ]
  },

  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "example-decave-media"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": false
    }
  }
}
