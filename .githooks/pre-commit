#!/bin/sh
set -eu

# Stop high-confidence credential material before it can enter a commit.
# Empty/example values and ordinary variable names are intentionally allowed.
pattern='-----BEGIN (RSA |EC |OPENSSH |DSA |PRIVATE) KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{20,}'

if git grep --cached -n -I -E -e "$pattern" -- .; then
  echo "ERROR: a likely credential was found in staged content. Commit aborted." >&2
  echo "Remove it from the staged snapshot and rotate it if it was real." >&2
  exit 1
fi

# Keep CI's `npm run format:check` green: check only the files being committed.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
if [ -n "$staged" ]; then
  if ! printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 npx --no-install prettier --check --ignore-unknown --log-level warn; then
    echo "ERROR: staged files are not formatted. Run: npx prettier --write <files>, then re-stage." >&2
    exit 1
  fi
fi

exit 0
